# ESP Smart Control - Environment Configuration Example
# Copy this file to .env and configure for your local network

# Wi-Fi Configuration for ESP1 and ESP2
WIFI_SSID=Your_WiFi_SSID
WIFI_PASSWORD=Your_WiFi_Password

# ESP Devices IP Addresses (Leave blank for mDNS or automatic discovery)
ESP1_IP=192.168.1.150
ESP2_IP=192.168.1.151

# Backend Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_PATH=./data/esp_control.sqlite

# System Safety & Limits
MAX_PUMP_RUNTIME_SECONDS=10
PUMP_COOLDOWN_SECONDS=60
MOTOR_TIMEOUT_MS=1500
HEARTBEAT_TIMEOUT_SECONDS=10

# Simulation Mode (Set to true to run without physical ESP hardware connected)
SIMULATION_MODE=true

# Optional API Security Token (leave blank for local open LAN access)
API_SECRET_KEY=

# Optional Supabase Cloud Integration (For Vercel & remote mobile control)
SUPABASE_URL=
SUPABASE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
